# Caddy on_demand_tls 的 ask 白名单接口 — systemd 服务
# 安装:
#   sudo cp deploy/domain-sale-ask.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now domain-sale-ask
[Unit]
Description=Domain sale: Caddy on-demand TLS ask endpoint
After=network.target

[Service]
ExecStart=/usr/bin/python3 /var/www/domain-sale/scripts/ask_server.py
Environment=DOMAINS_JSON=/var/www/domain-sale/public/data/domains.json
User=www-data
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
