# Caddy on_demand_tls 的 ask 白名单接口 — systemd 服务
# 安装:
#   sudo cp deploy/domain4sale-ask.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now domain4sale-ask
# 已安装过、更新本文件后:
#   sudo cp deploy/domain4sale-ask.service /etc/systemd/system/ \
#     && sudo systemctl daemon-reload && sudo systemctl restart domain4sale-ask
[Unit]
Description=Domain4sale: Caddy on-demand TLS ask endpoint
After=network.target

[Service]
ExecStart=/usr/bin/python3 /var/www/domain4sale/scripts/ask_server.py
Environment=DOMAINS_JSON=/var/www/domain4sale/public/data/domains.json
User=www-data
# 沙箱加固：本服务只读 domains.json，整个文件系统挂为只读不影响运行
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
